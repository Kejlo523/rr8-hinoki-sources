From 7ef8b6fa5886bcde17d86b6b8980f6bcb47e78ab Mon Sep 17 00:00:00 2001
From: Kejlo <62387434+Kejlo523@users.noreply.github.com>
Date: Wed, 28 Oct 2026 15:01:09 +0100
Subject: [PATCH 4/4] init: preserve debug properties for working adb root on
 userdebug

---
 init/property_service.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/init/property_service.cpp b/init/property_service.cpp
index 90b46cf06e6722f1d987962d509efba00b2a9a43..00fe885dde95e6575e36bc91a26439068a6a41c4 100644
--- a/init/property_service.cpp
+++ b/init/property_service.cpp
@@ -828,6 +828,13 @@ static const char *snet_prop_value[] = {
 };
 
 static void workaround_snet_properties() {
+	// Debug builds must retain ro.debuggable and their actual build type.
+	// Masking them hides Rooted debugging in Settings and makes adbd drop
+	// privileges even after the user has enabled the ADB root service.
+	if (android::base::GetBoolProperty("ro.debuggable", false)) {
+		return;
+	}
+
 	LOG(INFO) << "snet: Hiding sensitive props";
 
 	// Hide all sensitive props
