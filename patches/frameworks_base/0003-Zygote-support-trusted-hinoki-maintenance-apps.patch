From 8a1348f44bbf54da5c89d8b1251f8b3e1eddba9d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C4=99drek?= <62387434+Kejlo523@users.noreply.github.com>
Date: Thu, 17 Sep 2026 22:47:29 +0200
Subject: [PATCH 3/3] Zygote: support trusted hinoki maintenance apps

(cherry picked from commit aac70f519c943fcf7538097b2f6da98b55600b9b)
---
 core/jni/com_android_internal_os_Zygote.cpp | 32 +++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 440988b1bd4f83bc2064922865bca9f33f5c5b02..3c2364ff2f2dacbd20ce1ab651c358c205489b02 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -532,7 +532,28 @@ static void PreApplicationInit() {
   mallopt(M_DECAY_TIME, 1);
 }
 
-static void SetUpSeccompFilter(uid_t uid, bool is_child_zygote) {
+static bool IsHinokiRootApp(const std::optional<std::string>& nice_name) {
+  if (!nice_name.has_value()) return false;
+
+  static constexpr std::array<std::string_view, 3> kRootPackages = {
+      "ru.andr7e.deviceinfohw",
+      "com.nhellfire.kerneladiutor",
+      "com.duckduckgo.mobile.android",
+  };
+  const std::string_view process_name(nice_name.value());
+  for (const std::string_view package_name : kRootPackages) {
+    if (process_name == package_name ||
+        (process_name.size() > package_name.size() &&
+         process_name.substr(0, package_name.size()) == package_name &&
+         process_name[package_name.size()] == ':')) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static void SetUpSeccompFilter(uid_t uid, bool is_child_zygote,
+                               const std::optional<std::string>& nice_name) {
   if (!gIsSecurityEnforced) {
     ALOGI("seccomp disabled by setenforce 0");
     return;
@@ -540,6 +561,13 @@ static void SetUpSeccompFilter(uid_t uid, bool is_child_zygote) {
 
   // Apply system or app filter based on uid.
   if (uid >= AID_APP_START) {
+    // These explicitly bundled maintenance apps run in the SELinux su domain.
+    // A zygote app filter would otherwise kill their setuid helper with SIGSYS
+    // before SELinux can enforce the package-scoped su policy.
+    if (IsHinokiRootApp(nice_name)) {
+      ALOGI("seccomp disabled for privileged maintenance app %s", nice_name.value().c_str());
+      return;
+    }
     if (is_child_zygote) {
       set_app_zygote_seccomp_filter();
     } else {
@@ -1079,7 +1107,7 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
   // alternative is to call prctl(PR_SET_NO_NEW_PRIVS, 1) afterward, but that
   // breaks SELinux domain transition (see b/71859146).  As the result,
   // privileged syscalls used below still need to be accessible in app process.
-  SetUpSeccompFilter(uid, is_child_zygote);
+  SetUpSeccompFilter(uid, is_child_zygote, nice_name);
 
   // Must be called before losing the permission to set scheduler policy.
   SetSchedulerPolicy(fail_fn, is_top_app);
