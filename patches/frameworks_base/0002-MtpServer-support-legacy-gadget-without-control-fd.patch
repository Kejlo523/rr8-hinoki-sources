From 83ddb990509df155dc6fe26ff58fb2a40bd487fb Mon Sep 17 00:00:00 2001
From: Kejlo523 <62387434+Kejlo523@users.noreply.github.com>
Date: Fri, 28 Aug 2026 10:40:07 +0200
Subject: [PATCH 2/3] MtpServer: support legacy gadget without control fd

Change-Id: Idaee138b09ba81169ff9542fc49cac092ca62540
(cherry picked from commit aef0021a28e2c87a4ccfbe5dd836eb4160101e00)
---
 media/jni/android_mtp_MtpServer.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/media/jni/android_mtp_MtpServer.cpp b/media/jni/android_mtp_MtpServer.cpp
index 39ff04ab2a0a53fbae670a3723e99a6729542252..b8f7dd824e106ba3303a21bac6d23eef8158f8ac 100644
--- a/media/jni/android_mtp_MtpServer.cpp
+++ b/media/jni/android_mtp_MtpServer.cpp
@@ -64,7 +64,14 @@ android_mtp_MtpServer_setup(JNIEnv *env, jobject thiz, jobject javaDatabase, job
     const char *deviceInfoModelStr = env->GetStringUTFChars(deviceInfoModel, NULL);
     const char *deviceInfoDeviceVersionStr = env->GetStringUTFChars(deviceInfoDeviceVersion, NULL);
     const char *deviceInfoSerialNumberStr = env->GetStringUTFChars(deviceInfoSerialNumber, NULL);
-    int controlFd = dup(jniGetFDFromFileDescriptor(env, jControlFd));
+    // Legacy Android USB gadgets expose /dev/mtp_usb directly and therefore do
+    // not have a FunctionFS control descriptor. MtpServer detects that layout
+    // and selects MtpDevHandle, which does not use controlFd. Keep -1 for that
+    // path instead of dereferencing a null Java FileDescriptor.
+    int controlFd = -1;
+    if (jControlFd != nullptr) {
+        controlFd = dup(jniGetFDFromFileDescriptor(env, jControlFd));
+    }
     MtpServer* server = new MtpServer(getMtpDatabase(env, javaDatabase), controlFd,
             usePtp,
             (deviceInfoManufacturerStr != NULL) ? deviceInfoManufacturerStr : "",
