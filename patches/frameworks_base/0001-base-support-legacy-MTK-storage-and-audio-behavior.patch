 core/jni/fd_utils.cpp                         | 62 ++++++++++++-------
 .../server/audio/SoundEffectsHelper.java      | 10 +++
 2 files changed, 48 insertions(+), 24 deletions(-)

diff --git a/core/jni/fd_utils.cpp b/core/jni/fd_utils.cpp
index 8ba2559ec2efbd55e612c9c6d43a1379b5aaf2af..5de144048615a803277d7457bebf78ca228cc249 100644
--- a/core/jni/fd_utils.cpp
+++ b/core/jni/fd_utils.cpp
@@ -61,30 +61,38 @@ FileDescriptorWhitelist* FileDescriptorWhitelist::Get() {
 }
 
 bool FileDescriptorWhitelist::IsAllowed(const std::string& path) const {
+  // hinoki boots the Android 10 system from a bootbridge chroot mounted at
+  // /newroot.  The kernel reports inherited descriptors using that
+  // pre-chroot path (for example /newroot/sys/.../trace_marker), although
+  // the same object is visible as /sys/... inside Android.  Normalize it
+  // before applying the regular zygote whitelist.
+  const std::string normalized_path =
+      android::base::StartsWith(path, "/newroot/") ? path.substr(8) : path;
+
   // Check the static whitelist path.
   for (const auto& whitelist_path : kPathWhitelist) {
-    if (path == whitelist_path)
+    if (normalized_path == whitelist_path)
       return true;
   }
 
   // Check any paths added to the dynamic whitelist.
   for (const auto& whitelist_path : whitelist_) {
-    if (path == whitelist_path)
+    if (normalized_path == whitelist_path)
       return true;
   }
 
   // Framework jars are allowed.
   static const char* kFrameworksPrefix = "/system/framework/";
   static const char* kJarSuffix = ".jar";
-  if (android::base::StartsWith(path, kFrameworksPrefix)
-      && android::base::EndsWith(path, kJarSuffix)) {
+  if (android::base::StartsWith(normalized_path, kFrameworksPrefix)
+      && android::base::EndsWith(normalized_path, kJarSuffix)) {
     return true;
   }
 
   // Jars from the runtime apex are allowed.
   static const char* kRuntimeApexPrefix = "/apex/com.android.runtime/javalib/";
-  if (android::base::StartsWith(path, kRuntimeApexPrefix)
-      && android::base::EndsWith(path, kJarSuffix)) {
+  if (android::base::StartsWith(normalized_path, kRuntimeApexPrefix)
+      && android::base::EndsWith(normalized_path, kJarSuffix)) {
     return true;
   }
 
@@ -109,34 +117,34 @@ bool FileDescriptorWhitelist::IsAllowed(const std::string& path) const {
   static const char* kOemOverlayDir = "/oem/overlay";
   static const char* kApkSuffix = ".apk";
 
-  if ((android::base::StartsWith(path, kOverlayDir)
-       || android::base::StartsWith(path, kVendorOverlaySubdir)
-       || android::base::StartsWith(path, kVendorOverlayDir)
-       || android::base::StartsWith(path, kSystemProductOverlayDir)
-       || android::base::StartsWith(path, kProductOverlayDir)
-       || android::base::StartsWith(path, kSystemProductServicesOverlayDir)
-       || android::base::StartsWith(path, kProductServicesOverlayDir)
-       || android::base::StartsWith(path, kSystemOdmOverlayDir)
-       || android::base::StartsWith(path, kOdmOverlayDir)
-       || android::base::StartsWith(path, kSystemOemOverlayDir)
-       || android::base::StartsWith(path, kOemOverlayDir))
-      && android::base::EndsWith(path, kApkSuffix)
-      && path.find("/../") == std::string::npos) {
+  if ((android::base::StartsWith(normalized_path, kOverlayDir)
+       || android::base::StartsWith(normalized_path, kVendorOverlaySubdir)
+       || android::base::StartsWith(normalized_path, kVendorOverlayDir)
+       || android::base::StartsWith(normalized_path, kSystemProductOverlayDir)
+       || android::base::StartsWith(normalized_path, kProductOverlayDir)
+       || android::base::StartsWith(normalized_path, kSystemProductServicesOverlayDir)
+       || android::base::StartsWith(normalized_path, kProductServicesOverlayDir)
+       || android::base::StartsWith(normalized_path, kSystemOdmOverlayDir)
+       || android::base::StartsWith(normalized_path, kOdmOverlayDir)
+       || android::base::StartsWith(normalized_path, kSystemOemOverlayDir)
+       || android::base::StartsWith(normalized_path, kOemOverlayDir))
+      && android::base::EndsWith(normalized_path, kApkSuffix)
+      && normalized_path.find("/../") == std::string::npos) {
     return true;
   }
 
   static const char* kOverlayIdmapPrefix = "/data/resource-cache/";
   static const char* kOverlayIdmapSuffix = ".apk@idmap";
-  if (android::base::StartsWith(path, kOverlayIdmapPrefix)
-      && android::base::EndsWith(path, kOverlayIdmapSuffix)
-      && path.find("/../") == std::string::npos) {
+  if (android::base::StartsWith(normalized_path, kOverlayIdmapPrefix)
+      && android::base::EndsWith(normalized_path, kOverlayIdmapSuffix)
+      && normalized_path.find("/../") == std::string::npos) {
     return true;
   }
 
   // All regular files that are placed under this path are whitelisted automatically.
   static const char* kZygoteWhitelistPath = "/vendor/zygote_whitelist/";
-  if (android::base::StartsWith(path, kZygoteWhitelistPath)
-      && path.find("/../") == std::string::npos) {
+  if (android::base::StartsWith(normalized_path, kZygoteWhitelistPath)
+      && normalized_path.find("/../") == std::string::npos) {
     return true;
   }
 
@@ -251,6 +259,12 @@ FileDescriptorInfo* FileDescriptorInfo::CreateFromFd(int fd, fail_fn_t fail_fn)
                                         strerror(errno)));
   }
 
+  // Store the path as it is visible inside the bootbridge chroot.  This is
+  // also the path ReopenOrDetach() must use after system_server is forked.
+  if (android::base::StartsWith(file_path, "/newroot/")) {
+    file_path.erase(0, 8);
+  }
+
   if (!whitelist->IsAllowed(file_path)) {
     fail_fn(std::string("Not whitelisted : ").append(file_path));
   }
diff --git a/services/core/java/com/android/server/audio/SoundEffectsHelper.java b/services/core/java/com/android/server/audio/SoundEffectsHelper.java
index cf5bc8d88c73ef064e614d922fbf9bd5d8d32bf4..42d8b910a8780ae57072e72e2bb1dbb6f0335d7e 100644
--- a/services/core/java/com/android/server/audio/SoundEffectsHelper.java
+++ b/services/core/java/com/android/server/audio/SoundEffectsHelper.java
@@ -30,6 +30,7 @@ import android.os.Environment;
 import android.os.Handler;
 import android.os.Looper;
 import android.os.Message;
+import android.os.SystemProperties;
 import android.util.Log;
 import android.util.PrintWriterPrinter;
 
@@ -156,6 +157,15 @@ class SoundEffectsHelper {
 
     // All the methods below run on the worker thread
     private void onLoadSoundEffects(OnEffectsLoadCompleteHandler onComplete) {
+        // Hinoki's Oreo MTK HAL cannot complete SoundPool initialization on
+        // Android 10. RR offloads effects to this helper, so keep the device's
+        // compatibility opt-out here rather than restoring the old AudioService.
+        if (SystemProperties.getBoolean("ro.audio.disable_sound_effects", false)) {
+            if (onComplete != null) {
+                onComplete.run(false /*success*/);
+            }
+            return;
+        }
         if (mSoundPoolLoader != null) {
             // Loading is ongoing.
             mSoundPoolLoader.addHandler(onComplete);
