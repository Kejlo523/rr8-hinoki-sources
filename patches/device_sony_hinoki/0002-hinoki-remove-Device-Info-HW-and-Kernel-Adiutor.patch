From e73759a5f803bd1b4ce1dfb1bd0220fe5aeb1f7d Mon Sep 17 00:00:00 2001
From: Kejlo <62387434+Kejlo523@users.noreply.github.com>
Date: Wed, 28 Oct 2026 14:47:18 +0100
Subject: [PATCH 2/2] hinoki: remove Device Info HW and Kernel Adiutor

---
 device.mk                                     |   6 ++----
 prebuilt_apps/Android.mk                      |  15 ---------------
 prebuilt_apps/DeviceInfoHW/DeviceInfoHW.apk   | Bin 3911798 -> 0 bytes
 prebuilt_apps/KernelAdiutor/KernelAdiutor.apk | Bin 4193048 -> 0 bytes
 4 files changed, 2 insertions(+), 19 deletions(-)
 delete mode 100644 prebuilt_apps/DeviceInfoHW/DeviceInfoHW.apk
 delete mode 100644 prebuilt_apps/KernelAdiutor/KernelAdiutor.apk

diff --git a/device.mk b/device.mk
index f8dabee0acdc017daf812027552001ac8925f6e0..65f6fbbc55552f7eeaea90903438683ad3d8f95a 100644
--- a/device.mk
+++ b/device.mk
@@ -27,9 +27,7 @@ TARGET_SCREEN_WIDTH := 720
 PRODUCT_COPY_FILES += \
     $(DEVICE_PATH)/configs/sensors/hals.conf:system/vendor/etc/sensors/hals.conf
 
-# Preinstalled diagnostics and maintenance tools
+# Preinstalled browser and command-line tools
 PRODUCT_PACKAGES += \
-    DeviceInfoHW \
     DuckDuckGo \
-    HinokiBusyBox \
-    KernelAdiutor
+    HinokiBusyBox
diff --git a/prebuilt_apps/Android.mk b/prebuilt_apps/Android.mk
index df2f84cbd45be6ba5c5bba8446c25e5d8df70e3a..e0663662ff07f9a5d3195e1c2bdf13037c7dd9f8 100644
--- a/prebuilt_apps/Android.mk
+++ b/prebuilt_apps/Android.mk
@@ -2,21 +2,6 @@ LOCAL_PATH := $(call my-dir)
 
 ifeq ($(TARGET_DEVICE),hinoki)
 
-define hinoki_prebuilt_priv_app
-include $$(CLEAR_VARS)
-LOCAL_MODULE := $(1)
-LOCAL_SRC_FILES := $(1)/$(1).apk
-LOCAL_MODULE_CLASS := APPS
-LOCAL_MODULE_SUFFIX := $$(COMMON_ANDROID_PACKAGE_SUFFIX)
-LOCAL_CERTIFICATE := platform
-LOCAL_PRIVILEGED_MODULE := true
-LOCAL_DEX_PREOPT := false
-include $$(BUILD_PREBUILT)
-endef
-
-$(eval $(call hinoki_prebuilt_priv_app,DeviceInfoHW))
-$(eval $(call hinoki_prebuilt_priv_app,KernelAdiutor))
-
 # GitHub rejects files larger than 100 MB in normal Git objects and public
 # forks cannot upload their own LFS objects. Reassemble the exact upstream APK
 # from two tracked chunks before the normal prebuilt-app rules sign it.
diff --git a/prebuilt_apps/DeviceInfoHW/DeviceInfoHW.apk b/prebuilt_apps/DeviceInfoHW/DeviceInfoHW.apk
deleted file mode 100644
index 6e31d5cc2267d7f3da3b2f7a41b5a770d0b2eefc..0000000000000000000000000000000000000000
GIT binary patch
literal 0
