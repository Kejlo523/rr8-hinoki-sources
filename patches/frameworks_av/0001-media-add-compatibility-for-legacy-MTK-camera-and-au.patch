diff --git a/services/audiopolicy/managerdefault/AudioPolicyManager.cpp b/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
index 9d98f898dd7f364aa13dab29d80ec48a4f957ebe..958088779d9dc8369947cfb3c663bde9d3241ccd 100644
--- a/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
+++ b/services/audiopolicy/managerdefault/AudioPolicyManager.cpp
@@ -2454,6 +2454,14 @@ status_t AudioPolicyManager::setStreamVolumeIndex(audio_stream_type_t stream,
                                                   int index,
                                                   audio_devices_t device)
 {
+    // The legacy MTK audio stack reports DEFAULT_FOR_VOLUME to AudioService
+    // instead of the currently routed output.  Updating that synthetic device
+    // leaves the existing speaker index untouched, so every volume change is
+    // silently ignored. Resolve it exactly as getStreamVolumeIndex() does.
+    if (device == AUDIO_DEVICE_OUT_DEFAULT_FOR_VOLUME) {
+        device = mEngine->getOutputDevicesForStream(stream, true /*fromCache*/).types();
+        device = Volume::getDeviceForVolume(device);
+    }
     auto attributes = mEngine->getAttributesForStreamType(stream);
     ALOGV("%s: stream %s attributes=%s", __func__,
           toString(stream).c_str(), toString(attributes).c_str());
diff --git a/services/camera/libcameraservice/api1/Camera2Client.cpp b/services/camera/libcameraservice/api1/Camera2Client.cpp
index 162b50f5ce7885c9d23b68237831865adcdc212d..4f58fd87aa86170dbae415bcb3ef9ad34de4b196 100644
--- a/services/camera/libcameraservice/api1/Camera2Client.cpp
+++ b/services/camera/libcameraservice/api1/Camera2Client.cpp
@@ -1571,6 +1571,22 @@ status_t Camera2Client::setParameters(const String8& params) {
     Parameters::focusMode_t focusModeBefore = l.mParameters.focusMode;
     res = l.mParameters.set(params);
     if (res != OK) return res;
+
+    char device[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.device", device, "");
+    if (!strcmp(device, "hinoki")) {
+        // The Sony Oreo HAL3 P2 node is unstable with its advertised 23 MP
+        // JPEG/ZSL configuration on Q. Apply one device-level compatibility
+        // profile in the camera1-over-HAL3 shim, shared by every API1 client.
+        l.mParameters.allowZslMode = false;
+        l.mParameters.slowJpegMode = true;
+        l.mParameters.pictureWidth = 640;
+        l.mParameters.pictureHeight = 480;
+        l.mParameters.pictureWidthLastSet = 640;
+        l.mParameters.pictureHeightLastSet = 480;
+        l.mParameters.jpegThumbSize[0] = 160;
+        l.mParameters.jpegThumbSize[1] = 128;
+    }
     Parameters::focusMode_t focusModeAfter = l.mParameters.focusMode;
 
     if (l.mParameters.allowZslMode && focusModeAfter != focusModeBefore) {
diff --git a/services/camera/libcameraservice/api1/CameraClient.cpp b/services/camera/libcameraservice/api1/CameraClient.cpp
index 40c8e19413eb8d4dc6662ad6aac82396a8a1f12d..381b2ae10a0f3708e25c95c3eb456fb2aa8be987 100644
--- a/services/camera/libcameraservice/api1/CameraClient.cpp
+++ b/services/camera/libcameraservice/api1/CameraClient.cpp
@@ -32,6 +32,28 @@ namespace android {
 #define LOG1(...) ALOGD_IF(gLogLevel >= 1, __VA_ARGS__);
 #define LOG2(...) ALOGD_IF(gLogLevel >= 2, __VA_ARGS__);
 
+static bool needsHinokiCamera1Compat() {
+    char device[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.device", device, "");
+    return !strcmp(device, "hinoki");
+}
+
+static void applyHinokiCamera1Compat(CameraParameters* params) {
+    if (!needsHinokiCamera1Compat()) return;
+    // Sony's Oreo ZSD path relies on an old P2/gralloc contract. On Android Q
+    // it hangs before the JPEG callback or dereferences a null P2 buffer.
+    // Enforce the regular camera1 capture path centrally for every client.
+    params->set("zsl", "off");
+    params->set("zsd-mode", "off");
+    params->set("mtk-cam-mode", 0);
+    // Keep ZSD disabled, but retain the known-good stock capture stream.  A
+    // 640x480 diagnostic showed the second-shot corruption is session state,
+    // not a full-resolution P2 allocation failure.
+    params->setPictureSize(1920, 1088);
+    params->set(CameraParameters::KEY_JPEG_THUMBNAIL_WIDTH, 160);
+    params->set(CameraParameters::KEY_JPEG_THUMBNAIL_HEIGHT, 128);
+}
+
 CameraClient::CameraClient(const sp<CameraService>& cameraService,
         const sp<hardware::ICameraClient>& cameraClient,
         const String16& clientPackageName,
@@ -680,6 +702,16 @@ status_t CameraClient::takePicture(int msgType) {
         mBurstCnt = 1;
     LOG1("mBurstCnt = %d", mBurstCnt);
 
+    // The Oreo MTK HAL can leave a completed P2 capture attached to the
+    // camera session even after the app restarts preview or is reopened.  A
+    // post-callback cancel alone is racy because the app receives the JPEG
+    // asynchronously.  Clear any stale capture synchronously immediately
+    // before arming every new still request.
+    if (needsHinokiCamera1Compat()) {
+        status_t err = mHardware->cancelPicture();
+        ALOGI("hinoki: reset MTK capture before JPEG (%d)", err);
+    }
+
     return mHardware->takePicture();
 }
 
@@ -691,8 +723,9 @@ status_t CameraClient::setParameters(const String8& params) {
     status_t result = checkPidAndHardware();
     if (result != NO_ERROR) return result;
 
-    mLatestSetParameters = CameraParameters(params);
     CameraParameters p(params);
+    applyHinokiCamera1Compat(&p);
+    mLatestSetParameters = p;
     return mHardware->setParameters(p);
 }
 
@@ -704,7 +737,9 @@ String8 CameraClient::getParameters() const {
         return String8();
     }
 
-    String8 params(mHardware->getParameters().flatten());
+    CameraParameters cameraParams(mHardware->getParameters());
+    applyHinokiCamera1Compat(&cameraParams);
+    String8 params(cameraParams.flatten());
     LOG1("getParameters (pid %d) (%s)", CameraThreadState::getCallingPid(), params.string());
     return params;
 }
@@ -872,6 +907,32 @@ void CameraClient::dataCallback(int32_t msgType,
     sp<CameraClient> client = getClientFromCookie(user);
     if (client.get() == nullptr) return;
 
+    // Sony's MTK camera1 HAL wraps the final JPEG in MTK_CAMERA_MSG_EXT_DATA
+    // instead of sending CAMERA_MSG_COMPRESSED_IMAGE. The first two uint32_t
+    // words are the MTK subtype (16 == compressed image) and a reserved word;
+    // the JPEG starts immediately afterwards. Translate this vendor callback
+    // in cameraserver so every camera1 application receives the standard API.
+    if (needsHinokiCamera1Compat() && msgType == 0x20000000 && dataPtr != nullptr &&
+            dataPtr->size() > 2 * sizeof(uint32_t)) {
+        const uint32_t* words = static_cast<const uint32_t*>(dataPtr->pointer());
+        if (words != nullptr && words[0] == 0x10) {
+            ssize_t offset = 0;
+            size_t size = 0;
+            sp<IMemoryHeap> heap = dataPtr->getMemory(&offset, &size);
+            constexpr size_t kMtkExtHeaderSize = 2 * sizeof(uint32_t);
+            if (heap == nullptr || size <= kMtkExtHeaderSize) {
+                ALOGE("Invalid hinoki MTK JPEG callback: heap=%p size=%zu",
+                        heap.get(), size);
+                return;
+            }
+            sp<IMemory> jpeg = new MemoryBase(heap, offset + kMtkExtHeaderSize,
+                    size - kMtkExtHeaderSize);
+            if (!client->lockIfMessageWanted(CAMERA_MSG_COMPRESSED_IMAGE)) return;
+            client->handleCompressedPicture(jpeg);
+            return;
+        }
+    }
+
     if (!client->lockIfMessageWanted(msgType)) return;
     if (dataPtr == 0 && metadata == NULL) {
         ALOGE("Null data returned in data callback");
@@ -1065,6 +1126,14 @@ void CameraClient::handleCompressedPicture(const sp<IMemory>& mem) {
     if (!mBurstCnt && !mLongshotEnabled) {
         LOG1("handleCompressedPicture mBurstCnt = %d", mBurstCnt);
         disableMsgType(CAMERA_MSG_COMPRESSED_IMAGE);
+        // The legacy MTK HAL leaves its capture pipeline armed after sending
+        // an EXT_DATA JPEG.  The next takePicture() then reuses the stale P2
+        // output and returns a uniform green frame.  Stock MTK cameraservice
+        // finalizes that vendor capture here; AOSP normally has no need to.
+        if (needsHinokiCamera1Compat()) {
+            status_t err = mHardware->cancelPicture();
+            ALOGI("hinoki: finalized MTK capture after JPEG (%d)", err);
+        }
     }
 
     sp<hardware::ICameraClient> c = mRemoteCallback;
