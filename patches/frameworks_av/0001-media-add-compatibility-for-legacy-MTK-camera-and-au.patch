 media/libstagefright/CameraSource.cpp         | 24 ++++++
 media/libstagefright/MediaCodecSource.cpp     | 10 +++
 .../bqhelper/GraphicBufferSource.cpp          | 16 +++-
 .../include/media/stagefright/CameraSource.h  |  1 +
 .../managerdefault/AudioPolicyManager.cpp     |  8 ++
 .../libcameraservice/api1/Camera2Client.cpp   | 16 ++++
 .../libcameraservice/api1/CameraClient.cpp    | 73 ++++++++++++++++++-
 8 files changed, 163 insertions(+), 6 deletions(-)

diff --git a/media/libmediaplayerservice/StagefrightRecorder.cpp b/media/libmediaplayerservice/StagefrightRecorder.cpp
index 1e7cf9784877285686980f8502a69054d80ce21b..842bb722559949dc5b6fe75538ab0a44fd9b9b98 100644
--- a/media/libmediaplayerservice/StagefrightRecorder.cpp
+++ b/media/libmediaplayerservice/StagefrightRecorder.cpp
@@ -1615,6 +1615,22 @@ status_t StagefrightRecorder::setupMediaSource(
 
 status_t StagefrightRecorder::setupCameraSource(
         sp<CameraSource> *cameraSource) {
+    const bool hinokiRawVideoBuffers =
+            android::base::GetProperty("ro.product.device", "") == "hinoki";
+    if (hinokiRawVideoBuffers) {
+        // The stock profile advertises 1080p, but the legacy camera1 record
+        // heap delivered on Q uses padded camera1 YUV streams. Configuring the
+        // software encoder for 1080p makes MediaCodecSource copy beyond the
+        // mapped MTK ashmem buffer after the first batch of frames.  Keep the
+        // software encode/decode path at VGA and a sane bitrate for this SoC.
+        mVideoWidth = 480;
+        mVideoHeight = 320;
+        mFrameRate = 15;
+        mVideoBitRate = 700000;
+        mVideoEncoderLevel = -1;
+        ALOGI("hinoki: forcing coherent camera/encoder size %dx%d",
+                mVideoWidth, mVideoHeight);
+    }
     status_t err = OK;
     if ((err = checkVideoEncoderCapabilities()) != OK) {
         return err;
@@ -1637,7 +1653,10 @@ status_t StagefrightRecorder::setupCameraSource(
         *cameraSource = CameraSource::CreateFromCamera(
                 mCamera, mCameraProxy, mCameraId, mClientName, mClientUid, mClientPid,
                 videoSize, mFrameRate,
-                mPreviewSurface);
+                mPreviewSurface, !hinokiRawVideoBuffers);
+        if (hinokiRawVideoBuffers) {
+            ALOGI("hinoki: forcing camera1 YUV buffers for software video encoder");
+        }
     }
     mCamera.clear();
     mCameraProxy.clear();
diff --git a/media/libstagefright/CameraSource.cpp b/media/libstagefright/CameraSource.cpp
index 3bca728d3d8dffa897e7c611b35c4832f6953684..5eec51f6825aba948bcd72cc698fee800cb3924d 100644
--- a/media/libstagefright/CameraSource.cpp
+++ b/media/libstagefright/CameraSource.cpp
@@ -46,6 +46,15 @@ namespace android {
 
 static const int64_t CAMERA_SOURCE_TIMEOUT_NS = 3000000000LL;
 
+static bool isHinokiDevice() {
+    static const bool isHinoki = []() {
+        char device[PROPERTY_VALUE_MAX] = {};
+        property_get("ro.product.device", device, "");
+        return !strcmp(device, "hinoki");
+    }();
+    return isHinoki;
+}
+
 struct CameraSourceListener : public CameraListener {
     explicit CameraSourceListener(const sp<CameraSource> &source);
 
@@ -216,6 +225,7 @@ CameraSource::CameraSource(
     : mCameraFlags(0),
       mNumInputBuffers(0),
       mVideoFrameRate(-1),
+      mRequestedVideoFrameRate(frameRate),
       mCamera(0),
       mSurface(surface),
       mNumFramesReceived(0),
@@ -1161,6 +1171,20 @@ bool CameraSource::shouldSkipFrameLocked(int64_t timestampUs) {
         return true;
     }
 
+    // The XA1 camera HAL claims that the requested 15 fps mode is active but
+    // continues delivering frames at roughly 30 fps.  The software AVC codec
+    // cannot decode that stream in real time on this device.  Enforce the
+    // requested cadence here, while recording buffers can still be returned
+    // safely to the legacy camera HAL.
+    if (isHinokiDevice() && mRequestedVideoFrameRate > 0 &&
+            mRequestedVideoFrameRate < 30 && mNumFramesReceived > 0) {
+        const int64_t minFrameIntervalUs =
+                (1000000LL / mRequestedVideoFrameRate) * 9 / 10;
+        if (timestampUs - mLastFrameTimestampUs < minFrameIntervalUs) {
+            return true;
+        }
+    }
+
     if (mNumFramesReceived > 0) {
         if (timestampUs <= mLastFrameTimestampUs) {
             ALOGW("Dropping frame with backward timestamp %lld (last %lld)",
diff --git a/media/libstagefright/MediaCodecSource.cpp b/media/libstagefright/MediaCodecSource.cpp
index 836b881359fed5b288da7f12881e409c58758b8f..0f6fedf3a57c25ec4993f7f34b89f0aa2982efad 100644
--- a/media/libstagefright/MediaCodecSource.cpp
+++ b/media/libstagefright/MediaCodecSource.cpp
@@ -744,6 +744,16 @@ status_t MediaCodecSource::feedEncoderInputBuffers() {
 
             size = mbuf->size();
 
+            if (size > inbuf->capacity()) {
+                // Legacy MTK camera1 allocates recording slots at 2 bytes per
+                // pixel but delivers YUV420 (1.5 bytes/pixel).  IMemory::size
+                // describes the whole allocation, including the unused tail.
+                // The software encoder buffer describes only active pixels.
+                ALOGW("Trimming padded camera frame: allocation=%zu active=%zu",
+                        size, inbuf->capacity());
+                size = inbuf->capacity();
+            }
+
             memcpy(inbuf->data(), mbuf->data(), size);
 
             if (mIsVideo) {
diff --git a/media/libstagefright/bqhelper/GraphicBufferSource.cpp b/media/libstagefright/bqhelper/GraphicBufferSource.cpp
index ea1a406df37bcaa0cbff1c243c96ec08d1d30608..8f24c5aafd5e1f8e592a6807fc1b00debc0b7f74 100644
--- a/media/libstagefright/bqhelper/GraphicBufferSource.cpp
+++ b/media/libstagefright/bqhelper/GraphicBufferSource.cpp
@@ -15,6 +15,7 @@
  */
 
 #include <inttypes.h>
+#include <cutils/properties.h>
 
 #define LOG_TAG "GraphicBufferSource"
 //#define LOG_NDEBUG 0
@@ -1162,9 +1163,18 @@ status_t GraphicBufferSource::configure(
         consumerUsage |= GRALLOC_USAGE_HW_VIDEO_ENCODER;
         mConsumer->setConsumerUsageBits(consumerUsage);
 
-        // Set impl. defined format as default. Depending on the usage flags
-        // the device-specific implementation will derive the exact format.
-        err = mConsumer->setDefaultBufferFormat(HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED);
+        // Legacy gralloc implementations can leave IMPLEMENTATION_DEFINED as
+        // the actual buffer format even for a CPU-backed software encoder.
+        // SoftVideoEncoderOMXComponent cannot convert that opaque value and
+        // screen recording then fails as soon as the first frame arrives.
+        // Keep the AOSP behaviour by default and allow affected devices to
+        // request an explicit RGBA surface that the software encoder can lock
+        // and convert to YUV.
+        const int32_t defaultFormat = property_get_bool(
+                "persist.vendor.media.swenc_rgba", false)
+                ? HAL_PIXEL_FORMAT_RGBA_8888
+                : HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED;
+        err = mConsumer->setDefaultBufferFormat(defaultFormat);
         if (err != NO_ERROR) {
             ALOGE("Failed to configure surface default format ret: %d", err);
             return err;
diff --git a/media/libstagefright/include/media/stagefright/CameraSource.h b/media/libstagefright/include/media/stagefright/CameraSource.h
index 3037b72ff89976cc85180598381da8dc9d1cf69d..69517f632f6355c9a789639ca24d0b3a40fee489 100644
