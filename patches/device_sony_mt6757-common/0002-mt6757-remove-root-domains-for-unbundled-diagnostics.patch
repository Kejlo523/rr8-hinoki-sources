 # limited to the APKs bundled by the hinoki product.
-user=_app isPrivApp=true seinfo=platform name=ru.andr7e.deviceinfohw domain=su type=privapp_data_file levelFrom=user
-user=_app isPrivApp=true seinfo=platform name=com.nhellfire.kerneladiutor domain=su type=privapp_data_file levelFrom=user
 user=_app isPrivApp=true seinfo=platform name=com.duckduckgo.mobile.android domain=su type=privapp_data_file levelFrom=user
